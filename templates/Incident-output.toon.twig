{% if json.objects === null %}
Sorry, no such Incident exists in iTop.
{% else %}
{% for obj in json.objects %}
class Incident:
  id,ref,title,status,caller_id_friendlyname,org_id_friendlyname,priority

Incident {
  {{obj.key}}, {{obj.fields.ref}}, "{{obj.fields.title|e('js')}}", {{obj.fields.status}}, "{{obj.fields.caller_id_friendlyname|e('js')}}" , "{{obj.fields.org_id_friendlyname|e('js')}}", {{obj.fields.priority}}
}
{% endfor %}
{% endif %}